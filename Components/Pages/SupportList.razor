@page "/support-list"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<h3>Supporthenvendelser</h3>
<p><strong>Version 3 - antal henvendelser</strong></p>
@if (messages != null)
{
    <p>Antal henvendelser: @messages.Count</p>
}
@* guide - kategorifilter *@
<div class="mb-3">
    <label>Vælg kategori:</label>

    <select class="form-select" @onchange="CategoryChanged">
        <option value="Alle">Alle</option>
        <option value="Teknisk problem">Teknisk problem</option>
        <option value="Fakturering">Fakturering</option>
        <option value="Generel henvendelse">Generel henvendelse</option>
    </select>
</div>
@if (messages == null)
{
    <p>Indlæser...</p>
}
else if (messages.Count == 0)
{
    <p>Der er ingen supporthenvendelser.</p>
    
}

else
{
    <table class="table">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Kategori</th>
            <th>Beskrivelse</th>
            <th>Dato</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var message in messages)
        {
            <tr>
                <td>@message.Name</td>
                <td>@message.Email</td>
                <td>@message.Phone</td>
                <td>@message.Category</td>
                <td>@message.Description</td>
                <td>@message.CreatedAt</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage>? messages;

    protected override async Task OnInitializedAsync()
    {
        messages = await CosmosDbService.GetSupportMessagesAsync();
    }
    // guide - skifter mellem alle beskeder og en bestemt kategori
    private async Task CategoryChanged(ChangeEventArgs e)
    {
        var category = e.Value?.ToString();

        if (category == "Alle")
        {
            messages = await CosmosDbService.GetSupportMessagesAsync();
        }
        else if (!string.IsNullOrEmpty(category))
        {
            messages = await CosmosDbService.GetSupportMsgByCategoryAsync(category);
        }
    }
}