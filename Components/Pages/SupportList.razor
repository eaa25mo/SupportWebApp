@page "/support-list"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<h3>Supporthenvendelser</h3>

@if (messages == null)
{
    <p>Indlæser...</p>
}
else if (messages.Count == 0)
{
    <p>Der er ingen supporthenvendelser.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Kategori</th>
            <th>Beskrivelse</th>
            <th>Dato</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var message in messages)
        {
            <tr>
                <td>@message.Name</td>
                <td>@message.Email</td>
                <td>@message.Phone</td>
                <td>@message.Category</td>
                <td>@message.Description</td>
                <td>@message.CreatedAt</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage>? messages;

    protected override async Task OnInitializedAsync()
    {
        messages = await CosmosDbService.GetSupportMessagesAsync();
    }
}